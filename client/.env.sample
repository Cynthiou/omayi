# .env.sample - variables d'environnement du client OMAYI (Vite)
#
# Copier ce fichier en client/.env. Le .env n'est jamais versionné : ce
# fichier-ci ne contient aucun secret.
#
# Attention : tout ce qui est préfixé par VITE_ est embarqué dans le bundle
# envoyé au navigateur. Ne jamais y placer de secret.

# URL de l'API, lue dans le code avec import.meta.env.VITE_API_URL
VITE_API_URL=http://localhost:3310
