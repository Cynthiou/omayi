# .env.sample - variables lues par docker-compose.yml (MySQL de développement)
#
# Copier ce fichier en .env puis remplacer chaque A_DEFINIR par tes propres
# valeurs. Le .env n'est jamais versionné : ce fichier ne contient donc
# aucun identifiant réel.
#
# Les valeurs DB_NAME, DB_PORT, DB_USER et DB_PASSWORD doivent être
# identiques à celles de server/.env, sinon le serveur ne pourra pas
# se connecter au conteneur.

DB_NAME=omayi
DB_PORT=3306
DB_USER=A_DEFINIR
DB_PASSWORD=A_DEFINIR

# Mot de passe du compte root MySQL, utilisé uniquement par le conteneur
DB_ROOT_PASSWORD=A_DEFINIR
