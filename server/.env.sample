# .env.sample - variables d'environnement du serveur OBACY
#
# Copier ce fichier en server/.env puis remplacer chaque A_DEFINIR par tes
# valeurs. Le .env n'est jamais versionné : ce fichier-ci ne contient donc
# aucun identifiant réel.
#
# Toutes les variables ci-dessous sont obligatoires : le serveur refuse de
# démarrer si l'une d'elles manque (voir server/src/config/env.ts).

# Port d'écoute de l'API
APP_PORT=3310

# Connexion MySQL
# Ces valeurs doivent correspondre à celles du .env de la racine, qui
# configure le conteneur Docker de la base.
# 127.0.0.1 plutôt que localhost : sous Windows, localhost peut être résolu
# en IPv6 alors que le conteneur n'écoute qu'en IPv4.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=A_DEFINIR
DB_PASSWORD=A_DEFINIR
DB_NAME=obacy

# Seule origine autorisée par le CORS : l'URL du client en développement
CLIENT_URL=http://localhost:3000

# Les variables d'authentification (Supabase) seront ajoutées en US03.
